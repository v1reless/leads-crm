# Сервер
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Администратор. Это единственный источник логина и пароля.
# После изменения ADMIN_PASSWORD перезапустите сервер.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now

# SQLite. Папка создастся автоматически.
DB_PATH=./data/crm.sqlite

# Telegram-бот. Если токен и chat_id не заданы, заявки всё равно сохраняются.
BOT_TOKEN=
CHAT_ID=

# Публичный адрес CRM. Нужен для кнопки «Открыть в CRM» в Telegram.
# Для локальной разработки можно оставить localhost — кнопка просто не появится.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Если форма находится на другом домене, разрешите его здесь.
# Можно перечислить несколько origin через запятую.
# Пример: CORS_ORIGIN=https://v1reless.github.io,http://127.0.0.1:8787
CORS_ORIGIN=

# Для production за HTTPS:
# NODE_ENV=production
# COOKIE_SECURE=1
